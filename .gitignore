# macOS
.DS_Store

# IDE and agent-local state
.idea/
.idea.backup.*/
.vscode/
# Claude Code keeps its worktrees and local settings under the repository root.
# A leading './' is not a gitignore pattern, so the directory has to be written
# exactly like this to be ignored.
.claude/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
**/bin/
**/obj/
artifacts/
artifacts-check/
TestResults/
**/TestResults/

# NuGet package artifacts
*.nupkg
*.snupkg

# Temporary files
*.bak
*.tmp
*.temp
*.log
