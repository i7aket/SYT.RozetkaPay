<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SYT.RozetkaPay</RootNamespace>
        <AssemblyName>SYT.RozetkaPay</AssemblyName>
        <PackageId>SYT.RozetkaPay</PackageId>
        <Title>SYT RozetkaPay SDK</Title>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
        <Authors>Anatoliy Yermakov</Authors>
        <Company>SYT</Company>
        <Description>.NET SDK for RozetkaPay API with typed models, service clients, DI integration, and webhook payload support.</Description>
        <PackageTags>rozetkapay;payments;sdk;dotnet</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/i7aket/SYT.RozetkaPay</PackageProjectUrl>
        <RepositoryUrl>https://github.com/i7aket/SYT.RozetkaPay</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>package-icon.png</PackageIcon>
        <PackageReleaseNotes>See https://github.com/i7aket/SYT.RozetkaPay/blob/main/CHANGELOG.md for release notes.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <!--
        Reproducible builds and Source Link.

        Source Link generation is part of the .NET SDK itself (8.0+), so no
        Microsoft.SourceLink.* PackageReference is needed - and none is added, to
        keep the published dependency groups free of build-only packages. These
        properties only make the behaviour explicit instead of relying on SDK
        defaults, so a future SDK default change cannot silently drop it.
    -->
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <!--
            Normalizes compiled source paths to '/_/*' so official CI and release
            builds never embed the runner or worktree filesystem root in the PDB.
            Local developer builds keep real paths, which is what a local debugger
            wants. Both workflows also pass -p:ContinuousIntegrationBuild=true
            explicitly, so the official build contract is visible in the workflow
            file and does not depend on this condition alone.
        -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--
        Microsoft.Extensions.* tracks the runtime's own release line, so a net10.0 consumer gets
        10.0.x - which is what their shared framework already has loaded. Pinning an older line, as
        this file once did, quietly asks every consumer to carry a second copy of assemblies they
        already have.

        The condition is gone with the second target framework. EXP-425 dropped net9.0: it leaves
        support on 2026-11-10, and a package with no consumers yet is the only time removing a target
        is not a breaking change.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="../../LICENSE" Pack="true" PackagePath="/" />
        <!--
            PackageIcon requires the bitmap to be packed into the package root.
            The .svg source stays out of the package: consumers never need it.
        -->
        <None Include="../../assets/package-icon.png" Pack="true" PackagePath="/package-icon.png" />
    </ItemGroup>

</Project>
